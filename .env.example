DATABASE_CONNECTION=Host=localhost;Port=5432;Database=captapdb;Username=captap;Password=captappassword
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret-min-32-chars
EXPO_PUBLIC_API_URL=http://localhost:5001
# Physical device on your LAN (example — use your machine's IP, do not commit personal IPs):
# EXPO_PUBLIC_API_URL=http://192.168.1.25:5001
# Android emulator → host loopback:
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5001
# Production:
# EXPO_PUBLIC_API_URL=https://api.your-domain.com

EMAIL_PROVIDER=Mock
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME=CapTap
EMAIL_APP_BASE_URL=http://localhost:8081

# Docker Compose / production-style
POSTGRES_PASSWORD=captappassword
CAPTAP_API_PORT=5001
CORS_ALLOWED_ORIGINS=
# Production secrets belong in AWS Secrets Manager — never commit real values.
