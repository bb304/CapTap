# CapTap mobile — development environment
# Only EXPO_PUBLIC_* values are exposed to the app bundle. Never put secrets here.
#
# iOS simulator / web can use localhost.
# For a physical device on the same Wi-Fi, replace with your machine's LAN IP:
#   EXPO_PUBLIC_API_URL=http://192.168.1.100:5001
EXPO_PUBLIC_API_URL=http://localhost:5001
