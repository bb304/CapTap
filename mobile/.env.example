# CapTap mobile — public (non-secret) API base URL.
#
# Never commit machine-specific LAN IPs. Copy this file and edit locally:
#   cp .env.example .env.development.local
#   # or set EXPO_PUBLIC_API_URL in your shell / EAS secrets
#
# --- Emulator / simulator ---
# iOS Simulator / web:
EXPO_PUBLIC_API_URL=http://localhost:5001
#
# Android Emulator (host loopback):
# EXPO_PUBLIC_API_URL=http://10.0.2.2:5001
#
# --- Physical device (same Wi-Fi as your Mac) ---
# Find your LAN IP:  ipconfig getifaddr en0
# EXPO_PUBLIC_API_URL=http://192.168.x.x:5001
#
# --- Production / TestFlight / Play ---
# Must be HTTPS. Configure via EAS env, not a committed personal IP.
# EXPO_PUBLIC_API_URL=https://api.your-domain.com
