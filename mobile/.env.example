# CapTap mobile — public (non-secret) API base URL.
#
# Simulator / web:
#   EXPO_PUBLIC_API_URL=http://localhost:5001
#
# Physical device on the same Wi-Fi (replace with your Mac's LAN IP):
#   EXPO_PUBLIC_API_URL=http://192.168.1.100:5001
#
# Production must be HTTPS — never hardcode LAN IPs in .env.production.
EXPO_PUBLIC_API_URL=http://localhost:5001
